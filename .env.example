# Everything is OPTIONAL. Default mode is deterministic fixtures: no keys, no network.
# JEV_MODE=fixture            # fixture (default) | live
# GEMINI_API_KEY=             # live vision extraction (Gemini API)
# GEMINI_MODEL=               # e.g. the Gemini vision model you have access to
# JEV_ENDPOINT=               # optional bounded-decision model endpoint (can only ESCALATE the verdict)
# JEV_API_KEY=
# NEAR_RPC_URL=https://rpc.testnet.near.org
# NEARBLOCKS_API=https://api-testnet.nearblocks.io
